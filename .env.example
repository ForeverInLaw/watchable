# Relay
RELAY_BASE_URL=https://watch.example.com
# Built into the watch app too; only it may start pairing. At least 32 characters.
PAIRING_SECRET=replace-with-output-of-openssl-rand-base64-32
DATABASE_URL=sqlite+aiosqlite:///data/relay.db

# APNs
APNS_KEY_PATH=/secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_TOPIC=io.github.foreverinlaw.personalwatch.watchkitapp
APNS_USE_SANDBOX=false

# FCM: the Firebase project and a service account key of it; replies reach the Companion through it.
FCM_PROJECT_ID=your-project-id
FCM_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# Crypto / retention
DATA_KEY=replace-with-32-byte-base64
# How long a pairing code works.
PAIRING_TTL_SECONDS=600
RETENTION_DAYS=7
HEALTH_RETENTION_DAYS=30
